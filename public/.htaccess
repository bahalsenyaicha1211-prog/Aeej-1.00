# Compression des réponses texte
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
</IfModule>

# Cache long pour les assets statiques.
# build/ est versionné par Vite (hash dans le nom) ; css/ & js/ portent un ?v=filemtime.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # En-têtes de sécurité sur toutes les réponses.
    # - X-Frame-Options / frame-ancestors : empêche d'intégrer le site dans
    #   une <iframe> tierce (habillage de clic).
    # - X-Content-Type-Options : empêche le navigateur de deviner un type
    #   MIME différent de celui déclaré (protection contre certains XSS).
    # - Referrer-Policy : n'envoie l'URL complète qu'aux requêtes de même
    #   origine, seule l'origine (pas le chemin) aux sites tiers.
    # - Strict-Transport-Security : n'a d'effet qu'en HTTPS (ignoré en HTTP
    #   par le navigateur, donc sans danger en local).
    # - Permissions-Policy : désactive des API que le site n'utilise pas.
    # Pas de Content-Security-Policy complète ici : le site s'appuie sur des
    # <style>/<script> en ligne sur de nombreuses pages ; une CSP stricte
    # casserait ces pages sans une refonte en profondeur (nonces/hashes).
    # Seule la directive frame-ancestors est ajoutée, sans risque, en renfort
    # de X-Frame-Options pour les navigateurs qui la préfèrent.
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
    Header always set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
